# API Configuration
# Server-side backend URL for Next.js (required at build, next.config.ts)
BACKEND_URL=http://127.0.0.1:8000
# Client-side API base URL (src/lib/config.ts)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase Realtime (src/lib/realtime-client.ts) — optional; realtime disabled if unset
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
